# ZERO FLARE — environment variables (names only; never commit real keys)
# Copy to .env.local for local development (already git-ignored).

# AI provider for CIR-1 synthesis (CODEX Phase 3)
# gemini = native tool-calling via @google/genai (preferred free tier)
# verified live with function calling on 2026-11-13 (gemini-2.0-flash retired by Google;
# flash-lite = fastest free-tier tool-calling rounds, ~3s vs ~25s on flash proper)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=

# Optional: any OpenAI-compatible endpoint (Groq / Z.ai open platform / etc.)
# Used as automatic fallback when the primary provider fails.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Database (Prisma — present but unused at runtime)
DATABASE_URL="file:./db/custom.db"
